{
    "name": "js-replace",
    "version": "0.0.1",
    "description": "A minimal, zero-dependency function replace/restore utility for JavaScript.",
    "keywords": [
        "replace",
        "restore",
        "monkey-patch",
        "inject",
        "miniprogram",
        "小程序",
        "wechat"
    ],
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "miniprogram": "dist/cjs",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "directories": {
        "src": "src",
        "test": "test"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rimraf dist && tsdown",
        "dev": "tsdown --watch",
        "clean": "rimraf dist",
        "test": "jest",
        "test:dist": "node scripts/smoke-cjs.cjs && node scripts/smoke-esm.mjs",
        "prepublishOnly": "npm test && npm run build && npm run test:dist"
    },
    "license": "MIT",
    "dependencies": {},
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.2.1",
        "esbuild": "^0.28.1",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.9",
        "typescript": "^5.9.2"
    },
    "author": "xesam <xesam@outlook.com>",
    "homepage": "https://github.com/xesam/js-replace#readme",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xesam/js-replace.git"
    },
    "bugs": {
        "url": "https://github.com/xesam/js-replace/issues"
    }
}
