page {
    background: #f5f5f5;
}
.container {
    padding: 32rpx;
}
.title {
    font-size: 36rpx;
    font-weight: 600;
    margin-bottom: 24rpx;
}
.row {
    background: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
}
.row .label {
    color: #888;
    font-size: 24rpx;
    margin-bottom: 8rpx;
}
.row .value {
    font-size: 30rpx;
    word-break: break-all;
}
